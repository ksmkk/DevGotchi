# ======================================
# DevGotchi Backend - Configuración de Entorno
# ======================================
# Copia este archivo a `.env` y completa los valores

# Puerto en el que se ejecuta el servidor
PORT=3000

# Configuración de PostgreSQL
# NOTA: Si DB_HOST está configurado, se usa PostgreSQL
#       Si NO está configurado, se usa SQLite (desarrollo local)
DB_HOST=localhost
DB_PORT=5432
POSTGRES_USER=devgotchi
POSTGRES_PASSWORD=devgotchi_password
POSTGRES_DB=devgotchi

# (Opcional) Configuración adicional
# NODE_ENV=development
# JWT_SECRET=your_secret_key_here
# GITHUB_WEBHOOK_SECRET=your_github_webhook_secret
