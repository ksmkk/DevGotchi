# ======================================
# DevGotchi Backend - Configuración de Entorno
# ======================================
# Copia este archivo a `.env` y completa los valores

# Puerto en el que se ejecuta el servidor
PORT=3000

# Configuración de PostgreSQL
# `localhost` activa SQLite para la demo sin servicios externos.
# Docker Compose sobrescribe este valor con `postgres` para usar PostgreSQL.
DB_HOST=localhost
DB_PORT=5432
POSTGRES_USER=devgotchi
POSTGRES_PASSWORD=devgotchi_password
POSTGRES_DB=devgotchi

# (Opcional) Configuración adicional
# NODE_ENV=development
# JWT_SECRET=your_secret_key_here
FRONTEND_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=
GITHUB_WEBHOOK_SECRET=
GITHUB_WEBHOOK_URL=
# Token opcional de solo lectura para repos privados y alertas de seguridad
GITHUB_TOKEN=
SESSION_SECRET=
# Ruta opcional para el almacén cifrado de conexiones OAuth.
GITHUB_CONNECTION_STORE=
